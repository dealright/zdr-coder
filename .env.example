# Copy to .env and fill in these five values. Everything else has sensible defaults.
#
#   cp .env.example .env
#   $EDITOR .env
#   ./scripts/deploy.sh
#

# 1. LiteLLM master key — YOUR API key (what Cline sends).  Generate: openssl rand -hex 32
LITELLM_MASTER_KEY=

# 2. Tailscale auth key (reusable, ephemeral).  https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# 3. Hugging Face token (read scope).  https://huggingface.co/settings/tokens
#    Accept the model license first: https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash
HF_TOKEN=

# 4. RunPod API key.  https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# 5. Your container image. Either:
#      (a) Use a pre-built image: ghcr.io/OWNER/zdr-coder-gpu:latest  (no build step)
#      (b) Build & push your own:  cd gpu-node && docker build -t ghcr.io/YOUR_USER/zdr-coder-gpu:latest . && docker push ghcr.io/YOUR_USER/zdr-coder-gpu:latest
GPU_IMAGE=

# ── Optional overrides (defaults in scripts/deploy.sh) ───────────────────
# Defaults: DeepSeek V4 Flash on 2x H200, RunPod Secure Cloud, ~$8.62/hr.
# Upgrade to Kimi K2.6 on 8x H100 by uncommenting:
#   GPU_TYPE_ID="NVIDIA H100 80GB HBM3"
#   GPU_COUNT=8
#   CONTAINER_DISK_GB=700
#   MODEL=moonshotai/Kimi-K2.6-Instruct
#   TP_SIZE=8
#   MAX_LEN=131072
