# zdr-coder configuration.
#
# Required: ONE value below.
#
#   cp .env.example .env
#   $EDITOR .env            # set RUNPOD_API_KEY
#   ./scripts/deploy.sh
#

# RunPod API key.  https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=


# ─────────────────────────────────────────────────────────────
# Optional: pick a profile.  Default = sonnet.
# Uncomment ONE block.  Everything else is auto-handled.
# ─────────────────────────────────────────────────────────────

# ── haiku tier (~Claude Haiku 4.5 for cheap coding) ──────────
# GPU_TYPE_ID=NVIDIA RTX A5000
# GPU_COUNT=1
# CONTAINER_DISK_GB=120
# MODEL=Qwen/Qwen3-Coder-32B-Instruct
# TP_SIZE=1
# MAX_LEN=65536
# ~$0.27/hr   ~$22/mo @ 80 hrs

# ── sonnet tier (~Claude Sonnet 4.6) — DEFAULT ───────────────
# GPU_TYPE_ID=NVIDIA A100 80GB PCIe
# GPU_COUNT=2
# CONTAINER_DISK_GB=400
# MODEL=deepseek-ai/DeepSeek-V4-Flash
# TP_SIZE=2
# MAX_LEN=262144
# ~$2.98/hr   ~$238/mo @ 80 hrs  (cheapest 2-GPU)
# Or 2× H200 at ~$8.62/hr for more headroom.

# ── opus tier (~Claude Opus 4.7) ─────────────────────────────
# GPU_TYPE_ID=NVIDIA H100 80GB HBM3
# GPU_COUNT=8
# CONTAINER_DISK_GB=700
# MODEL=moonshotai/Kimi-K2.6-Instruct
# TP_SIZE=8
# MAX_LEN=131072
# ~$23.92/hr  ~$1,914/mo @ 80 hrs

# ── Other optional overrides ─────────────────────────────────
# HF_TOKEN=hf_...               # use original HuggingFace instead of HF-Mirror
# GPU_IMAGE=ghcr.io/dealright/zdr-coder-gpu:latest   # custom image
