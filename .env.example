# zdr-coder configuration.
#
# Required: ONE value below.
#
#   cp .env.example .env
#   $EDITOR .env            # set RUNPOD_API_KEY
#
# Then deploy:
#   ./scripts/deploy.sh sonnet      # default profile
#   ./scripts/deploy.sh haiku       # cheapest (~$0.27/hr)
#   ./scripts/deploy.sh opus        # best (~$23.92/hr)
#   ./scripts/deploy.sh all         # all 3 in parallel (background)
#
# Once deployed, switch models in Cline by changing Model ID to haiku/sonnet/opus.
#

# RunPod API key.  https://www.runpod.io/console/user/settings
# Pick the "All" permission scope — "Restricted" works for pod management
# but returns 403 on the /v2/<id>/openai/v1 serverless inference path.
RUNPOD_API_KEY=

# Vast.ai API key (only required for scripts/deploy-vast.sh — alternative
# provider with more on-demand capacity across all GPU tiers, ~50–70% cheaper
# than RunPod). Sign up at https://cloud.vast.ai/ then grab the key at
# https://cloud.vast.ai/account/.
VAST_API_KEY=

# Groq API key (only required for the API ZDR mode — third compute mode
# alongside self-hosted pods and serverless). Enables haiku-api / sonnet-api
# model IDs in LiteLLM with scale-to-zero, $0 idle, and Groq's self-serve
# ZDR toggle (Data Controls → Zero Data Retention). SOC 2 Type 2, ISO 27001,
# HIPAA BAA available without enterprise contract.
# Sign up at https://console.groq.com/ → API Keys.
# IMPORTANT: enable ZDR in console settings BEFORE first request, otherwise
# logs retain up to 30 days under their default policy.
GROQ_API_KEY=


# ─────────────────────────────────────────────────────────────
# Optional overrides. Profile defaults live in scripts/deploy.sh.
# ─────────────────────────────────────────────────────────────

# Use original HuggingFace instead of the no-token HF-Mirror:
# HF_TOKEN=hf_...

# Custom container image. Default is ghcr.io/dealright/zdr-coder-gpu:latest
# which auto-tracks every commit to main. Pin to a SHA only if you need
# reproducibility (e.g. production): :sha-XXXXX from the build workflow.
# DO NOT leave a stale SHA pin here — providers will use it instead of the
# auto-built :latest and you'll deploy old code.
# GPU_IMAGE=ghcr.io/yourname/zdr-coder-gpu:latest

# Per-deploy overrides apply only when running that profile. Example:
#   GPU_COUNT=4 ./scripts/deploy.sh sonnet
