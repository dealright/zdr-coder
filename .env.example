# zdr-coder configuration
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  QUICK START — what you actually need to do                              ║
# ╠══════════════════════════════════════════════════════════════════════════╣
# ║  1. cp .env.example .env                                                 ║
# ║  2. Open .env in your editor                                             ║
# ║  3. Set ZDR_TIER below (default: soc2)                                   ║
# ║  4. Fill the 3 keys for that tier (checklist printed next to each tier)  ║
# ║  5. Run: source .venv-sky/bin/activate && sky check                      ║
# ║  6. Run: ./start.command (mac) | start.bat (win) | ./scripts/api-up.sh   ║
# ╚══════════════════════════════════════════════════════════════════════════╝

ZDR_TIER=soc2


# ─────────────────────────────────────────────────────────────────────────────
# LEVEL 3 — Groq Cloud (works at EVERY tier, optional but recommended)
# ─────────────────────────────────────────────────────────────────────────────
# Powers `haiku-api` and `sonnet-api` (managed inference, $0 idle).
# • Sign up: https://console.groq.com/
# • CRITICAL: enable ZDR before first request:
#     https://console.groq.com/settings/data-controls (toggle Zero Data Retention ON)
# • Create key: https://console.groq.com/keys → copy `gsk_...` → paste below
# • BAA: email security@groq.com (only needed if you process PHI through Groq)

GROQ_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Z.ai direct API (powers `sonnet-glm-zai` route, GLM 5.2)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  NOT HIPAA-COMPATIBLE: Z.ai's direct API routes traffic through
#     Chinese infrastructure. DO NOT use for any workload involving US
#     healthcare data or other regulated content. For HIPAA-covered GLM
#     access, use `sonnet-glm` / `opus-glm` (Bedrock GLM 4.7-Flash / GLM 5)
#     instead — same model family, your existing BAA covers them.
#
# • Register/login at https://z.ai/model-api (Z.ai Open Platform)
# • Subscribe to GLM Coding Plan ($10-80/mo) for GLM 5.2 access today.
#   Public pay-per-token API rolls out roughly the week of 2026-06-20.
# • Generate key at https://z.ai/manage-apikey/apikey-list → copy → paste below.
# • Leave blank to disable the `sonnet-glm-zai` route (it'll return 401).

Z_AI_API_KEY=


# ════════════════════════════════════════════════════════════════════════════
# ZDR_TIER=soc2 ⭐ RECOMMENDED DEFAULT — fill these 3 keys
# ════════════════════════════════════════════════════════════════════════════
# 3-way failover across SOC2 Type II + ISO 27001 backends. SkyPilot picks
# the cheapest available per launch, falls over if one is out of capacity.
#
# Checklist:
#   [ ] Nebius     (primary  — EU+US, HIPAA in SOC2 scope)
#   [ ] Verda      (backup   — EU-sovereign Finland, cleanest 4× H200 SKU)
#   [ ] RunPod     (3rd      — US-heavy, smallest GPU sizes, BAA path exists)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Nebius (PRIMARY) ───────────────────────────────────────────────────────
# SOC2 Type II including HIPAA scope, ISO 27001/17/18/701
# Nebius credentials are NOT in this .env — SkyPilot reads them from files.
# • Sign up:        https://nebius.com/ → "Log in to AI Cloud"
# • Install CLI:    curl -sSL https://storage.eu-north1.nebius.cloud/cli/install.sh | bash
#                   exec -l $SHELL
# • Authenticate:   nebius profile create   (opens browser)
# • Service acct:   nebius iam service-account create --name skypilot
# • Write creds:    mkdir -p ~/.nebius && \
#                   SA_ID=$(nebius iam service-account get-by-name --name skypilot --format json | jq -r ".metadata.id") && \
#                   nebius iam auth-public-key generate --service-account-id "$SA_ID" --output ~/.nebius/credentials.json
# • Write tenant:   nebius iam tenant list --format json | jq -r '.items[0].metadata.id' > ~/.nebius/NEBIUS_TENANT_ID.txt
# • Verify:         sky check nebius
# • Docs:           https://docs.skypilot.co/en/latest/cloud-setup/cloud-permissions/nebius.html

# ─── Verda / DataCrunch (BACKUP) ────────────────────────────────────────────
# SOC2 Type II + ISO 27001/17/18/701, EU-sovereign (Finland)
# Verda credentials are NOT in this .env — SkyPilot reads ~/.verda/config.json.
# • Sign up:        https://console.verda.com → email signup
# • Create key:     Dashboard → your project → Keys → Create new API key
# • Write config:   mkdir -p ~/.verda && cat > ~/.verda/config.json <<EOF
#                   {
#                     "client_id": "your-client-id",
#                     "client_secret": "your-client-secret",
#                     "base_url": "https://api.verda.com/v1",
#                     "default_region": "FIN-03"
#                   }
#                   EOF
# • Verify:         sky check verda
# Or use ./scripts/setup-verda.sh to write the file interactively.

# ─── RunPod Secure Cloud (3rd, FAILOVER) ────────────────────────────────────
# SOC2 Type I (Type II in progress), SOC 3, BAA available via sales for Secure
# tier. We use Secure Cloud filter in sky/*.yaml (Community is NOT BAA-eligible).
# • Sign up:        https://www.runpod.io/
# • Create key:     https://console.runpod.io/user/settings → API Keys → Create
# • IMPORTANT:      Choose "All" scope (Restricted returns 403 on /openai/v1)

RUNPOD_API_KEY=


# ════════════════════════════════════════════════════════════════════════════
# ZDR_TIER=cheap — marketplace / lowest cost (no compliance)
# ════════════════════════════════════════════════════════════════════════════
# Fill any of these for cheapest possible GPU rental. RunPod and Vast.ai both
# work; Vast is cheapest when Secure Cloud host is available.
# Checklist:
#   [ ] Vast.ai  (cheapest, dynamic marketplace)
#   [ ] RunPod   (reuses RUNPOD_API_KEY above — both Community + Secure
#                 datacenters available at this tier)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Vast.ai ────────────────────────────────────────────────────────────────
# Marketplace; BAA via Secure Cloud tier only (compliance@vast.ai)
# • Sign up:        https://cloud.vast.ai/
# • Create key:     Account → API Keys → Create (Permissions: Instances RW, 2FA off)

VAST_API_KEY=


# ════════════════════════════════════════════════════════════════════════════
# ZDR_TIER=hipaa — BAA-signed providers
# ════════════════════════════════════════════════════════════════════════════
# Checklist:
#   [ ] AWS                     (primary — self-serve BAA in AWS Artifact)
#   [ ] OCI (Oracle Cloud)      (backup — FedRAMP High + BAA)
#   [ ] RunPod Secure Cloud     (3rd — cheaper, but email sales for BAA first)
# ─────────────────────────────────────────────────────────────────────────────

# ─── AWS (PRIMARY for hipaa tier) ───────────────────────────────────────────
# BAA is self-serve via AWS Artifact (click-through, no email needed)
# • Sign BAA:       https://aws.amazon.com/compliance/hipaa-compliance/
#                   AWS Console → AWS Artifact → Agreements → AWS BAA → Accept
# • Install CLI:    brew install awscli
# • Authenticate:   aws configure   (writes ~/.aws/credentials)
# • Region picks:   us-east-2 (Ohio) is the best for p5e Capacity Block stock

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2

# ─── OCI (Oracle Cloud) (BACKUP for hipaa tier) ─────────────────────────────
# EY-attested HIPAA program, FedRAMP High via JAB
# • Sign up:        https://www.oracle.com/cloud/free/
# • Sign BAA:       Account team (oracle.com/corporate/contact)
# • Install CLI:    brew install oci-cli
# • Authenticate:   oci setup config   (interactive, writes ~/.oci/config)

OCI_CONFIG_PROFILE=DEFAULT


# ════════════════════════════════════════════════════════════════════════════
# ZDR_TIER=fedramp — FedRAMP Moderate / High via hyperscalers only
# ════════════════════════════════════════════════════════════════════════════
# Checklist:
#   [ ] AWS    (uses AWS_* keys from hipaa section above)
#   [ ] Azure  (FedRAMP High, BAA auto-included in DPA)
#   [ ] GCP    (FedRAMP High via Assured Workloads)
#   [ ] OCI    (uses OCI_* config from hipaa section above)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Azure ──────────────────────────────────────────────────────────────────
# BAA auto-included in Online Services DPA. FedRAMP High.
# • Install CLI:    brew install azure-cli
# • Authenticate:   az login
# • Set subscription: az account set -s <subscription-id>

AZURE_SUBSCRIPTION_ID=

# ─── GCP ────────────────────────────────────────────────────────────────────
# Console BAA request. FedRAMP High via Assured Workloads.
# • Install CLI:    brew install --cask google-cloud-sdk
# • Authenticate:   gcloud auth application-default login
# • Set project:    gcloud config set project <project-id>

GCP_PROJECT_ID=


# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL OVERRIDES (rarely needed)
# ════════════════════════════════════════════════════════════════════════════

# ─── SkyPilot-launched self-hosted pod endpoints ────────────────────────────
# These are filled in AFTER `sky launch` succeeds. Endpoint format:
#   HAIKU_POD_API_BASE=http://<external-ip>:8080/v1
# Get current value with: sky status --endpoint 8080 haiku-pod
# Re-populate via .env-runtime after each tear-down/relaunch cycle.
HAIKU_POD_API_BASE=
SONNET_POD_API_BASE=
OPUS_POD_API_BASE=

# SkyPilot scale-to-zero (sky serve) endpoints — load balancer URLs, stable
# across replica rotations. Get via: sky serve status <name> --endpoint
HAIKU_SERVE_API_BASE=
SONNET_SERVE_API_BASE=
OPUS_SERVE_API_BASE=

# Custom Hugging Face token. The repo defaults to anonymous mirror — works
# fine for Kimi K2.6, DeepSeek V4 Flash, Qwen, GPT-OSS. Required only for
# gated models (Llama 3.x family).
# HF_TOKEN=hf_...

# Pin a specific vLLM image SHA. Default: ghcr.io/dealright/zdr-coder-gpu:latest
# (auto-tracks every commit to main). Pin only for production reproducibility.
# GPU_IMAGE=ghcr.io/dealright/zdr-coder-gpu:sha-xxxxxxx
